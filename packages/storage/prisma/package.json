{
	"name": "@busyclaw/storage-prisma",
	"version": "0.0.0",
	"type": "module",
	"description": "Prisma adapter for the @busyclaw/storage-core Adapter port \u2014 structurally typed, pass your generated PrismaClient. Patterns adapted from Better Auth (MIT).",
	"license": "MIT",
	"author": "Konstantin Ponomarev",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		}
	},
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"files": [
		"dist",
		"README.md"
	],
	"scripts": {
		"build": "tsc -p tsconfig.build.json",
		"test": "vitest run tests --no-file-parallelism",
		"typecheck": "tsc --noEmit",
		"pretest": "prisma db push --skip-generate --accept-data-loss"
	},
	"dependencies": {
		"@busyclaw/contracts": "workspace:*"
	},
	"devDependencies": {
		"@busyclaw/storage-core": "workspace:*",
		"@prisma/client": "6.19.3",
		"@types/node": "26.1.1",
		"prisma": "6.19.3"
	}
}
