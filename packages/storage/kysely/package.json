{
	"name": "@busyclaw/storage-kysely",
	"version": "0.0.0",
	"type": "module",
	"description": "Kysely adapter for the @busyclaw/storage-core Adapter port \u2014 works with any Kysely SQL dialect. Patterns adapted from Better Auth (MIT).",
	"license": "MIT",
	"author": "Konstantin Ponomarev",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		}
	},
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"files": [
		"dist",
		"README.md"
	],
	"scripts": {
		"build": "tsc -p tsconfig.build.json",
		"test": "vitest run tests",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"@busyclaw/contracts": "workspace:*"
	},
	"peerDependencies": {
		"kysely": ">=0.27.0"
	},
	"devDependencies": {
		"@busyclaw/storage-core": "workspace:*",
		"@types/better-sqlite3": "7.6.13",
		"better-sqlite3": "12.11.1",
		"kysely": "0.29.2"
	}
}
