{
	"name": "@busyclaw/contracts",
	"version": "0.0.0",
	"type": "module",
	"description": "The busyclaw protocol: governance boundary + plugin contracts, the entity schema DSL, and the port/schema definitions every busyclaw package speaks. Near-zero deps.",
	"license": "MIT",
	"author": "Konstantin Ponomarev",
	"homepage": "https://github.com/busyclaw-sh/busyclaw#readme",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/busyclaw-sh/busyclaw.git",
		"directory": "packages/foundation/contracts"
	},
	"bugs": {
		"url": "https://github.com/busyclaw-sh/busyclaw/issues"
	},
	"publishConfig": {
		"access": "public"
	},
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./claw-api": {
			"types": "./dist/claw-api.d.ts",
			"import": "./dist/claw-api.js"
		},
		"./governance/endpoints": {
			"types": "./dist/governance/endpoints.d.ts",
			"import": "./dist/governance/endpoints.js"
		}
	},
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"files": [
		"dist",
		"README.md"
	],
	"scripts": {
		"build": "tsc -p tsconfig.build.json",
		"test": "vitest run",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"@busyclaw/errors": "workspace:*",
		"arktype": "2.2.0"
	}
}
