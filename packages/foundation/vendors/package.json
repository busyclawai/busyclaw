{
	"name": "@busyclaw/vendors",
	"version": "0.0.0",
	"type": "module",
	"description": "Vendor-coupled authoring glue for busyclaw, one subpath per vendor. `@busyclaw/vendors/ai-sdk`: tool() defines a governed AI-SDK tool in one place \u2014 the model-facing definition plus the governance stamp. Feather-light: contracts + the vendor SDK only, no runtime.",
	"license": "MIT",
	"author": "Konstantin Ponomarev",
	"homepage": "https://github.com/busyclaw-sh/busyclaw#readme",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/busyclaw-sh/busyclaw.git",
		"directory": "packages/foundation/vendors"
	},
	"bugs": {
		"url": "https://github.com/busyclaw-sh/busyclaw/issues"
	},
	"publishConfig": {
		"access": "public"
	},
	"exports": {
		"./ai-sdk": {
			"types": "./dist/ai-sdk/index.d.ts",
			"import": "./dist/ai-sdk/index.js"
		}
	},
	"files": [
		"dist",
		"README.md"
	],
	"scripts": {
		"build": "tsc -p tsconfig.build.json",
		"test": "vitest run",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"@busyclaw/contracts": "workspace:*",
		"ai": "7.0.22"
	},
	"devDependencies": {
		"@busyclaw/core": "workspace:*",
		"arktype": "2.2.0"
	}
}
