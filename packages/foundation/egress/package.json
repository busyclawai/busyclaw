{
	"name": "@busyclaw/egress",
	"version": "0.0.0",
	"type": "module",
	"description": "busyclaw's outbound egress safety floor: the non-negotiable network guard beneath any policy \u2014 SSRF range rejection (loopback / private / link-local / CGNAT / unspecified, IPv4+IPv6), https-only, and resolve-once address pinning. The root entry is Node-free (the caller injects the DNS resolver); the ./node subpath binds node:dns and a pinned dispatcher.",
	"license": "MIT",
	"author": "Konstantin Ponomarev",
	"homepage": "https://github.com/busyclaw-sh/busyclaw#readme",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/busyclaw-sh/busyclaw.git",
		"directory": "packages/foundation/egress"
	},
	"bugs": {
		"url": "https://github.com/busyclaw-sh/busyclaw/issues"
	},
	"publishConfig": {
		"access": "public"
	},
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./node": {
			"types": "./dist/node.d.ts",
			"import": "./dist/node.js"
		},
		"./tool": {
			"types": "./dist/fetch-tool.d.ts",
			"import": "./dist/fetch-tool.js"
		}
	},
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"files": [
		"dist",
		"README.md"
	],
	"scripts": {
		"build": "tsc -p tsconfig.build.json",
		"test": "vitest run tests",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"@busyclaw/contracts": "workspace:*",
		"undici": "8.9.0"
	},
	"peerDependencies": {
		"ai": "^7.0.22"
	},
	"peerDependenciesMeta": {
		"ai": {
			"optional": true
		}
	},
	"devDependencies": {
		"ai": "7.0.22"
	}
}
