{
	"name": "@busyclaw/cli",
	"version": "0.0.0",
	"type": "module",
	"description": "The busyclaw CLI — `busyclaw db generate` / `busyclaw db migrate` over the schema your config declares.",
	"license": "MIT",
	"author": "Konstantin Ponomarev",
	"bin": {
		"busyclaw": "./dist/index.mjs"
	},
	"exports": {
		".": {
			"types": "./dist/index.d.mts",
			"import": "./dist/index.mjs"
		}
	},
	"main": "./dist/index.mjs",
	"types": "./dist/index.d.mts",
	"files": [
		"dist",
		"README.md"
	],
	"scripts": {
		"build": "tsdown",
		"test": "vitest run tests",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"@busyclaw/contracts": "workspace:*",
		"@busyclaw/storage-drizzle": "workspace:*",
		"@busyclaw/storage-kysely": "workspace:*",
		"@busyclaw/storage-mongodb": "workspace:*",
		"@busyclaw/storage-prisma": "workspace:*",
		"commander": "15.0.0",
		"busyclaw": "workspace:*",
		"jiti": "2.7.0"
	},
	"peerDependencies": {
		"kysely": ">=0.27.0"
	},
	"devDependencies": {
		"@busyclaw/storage-core": "workspace:*",
		"@types/better-sqlite3": "7.6.13",
		"@types/node": "26.1.1",
		"better-sqlite3": "12.11.1",
		"kysely": "0.29.2",
		"prisma": "6.19.3",
		"tsdown": "0.22.14"
	}
}
