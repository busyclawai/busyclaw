{
	"name": "@busyclaw/sandboxes",
	"version": "0.0.0",
	"type": "module",
	"description": "Governed code execution for busyclaw: the run_code tool over pluggable isolation providers; QuickJS (WASM, in-process) first.",
	"license": "MIT",
	"author": "Konstantin Ponomarev",
	"homepage": "https://github.com/busyclaw-sh/busyclaw#readme",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/busyclaw-sh/busyclaw.git",
		"directory": "packages/plugins/sandboxes"
	},
	"bugs": {
		"url": "https://github.com/busyclaw-sh/busyclaw/issues"
	},
	"publishConfig": {
		"access": "public"
	},
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./quickjs": {
			"types": "./dist/providers/quickjs/index.d.ts",
			"import": "./dist/providers/quickjs/index.js"
		},
		"./memory": {
			"types": "./dist/storages/memory/index.d.ts",
			"import": "./dist/storages/memory/index.js"
		}
	},
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"sideEffects": false,
	"files": [
		"dist",
		"README.md"
	],
	"scripts": {
		"build": "tsc",
		"test": "vitest run",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"@busyclaw/contracts": "workspace:*",
		"@busyclaw/egress": "workspace:*",
		"@jitl/quickjs-ng-wasmfile-release-sync": "0.32.0",
		"@sebastianwessel/quickjs": "3.1.0",
		"arktype": "2.2.0",
		"memfs": "4.57.8"
	},
	"peerDependencies": {
		"ai": "^7.0.22"
	},
	"devDependencies": {
		"@busyclaw/core": "workspace:*",
		"@busyclaw/runtime": "workspace:*",
		"@busyclaw/storage-core": "workspace:*",
		"ai": "7.0.22",
		"busyclaw": "workspace:*"
	}
}
