{
	"name": "@busyclaw/escalations",
	"version": "0.0.0",
	"type": "module",
	"description": "The escalations() plugin for busyclaw: declares the `escalate` and `guidance` Cedar policy annotations — a policy that says who should be asked (@escalate(\"betterauth:team_eng\")) reaches the host's onEscalate when a call parks or is denied, and one that says what to do instead (@guidance(\"…\")) reaches the agent. An observer: it changes no decision.",
	"license": "MIT",
	"author": "Konstantin Ponomarev",
	"homepage": "https://github.com/busyclaw-sh/busyclaw#readme",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/busyclaw-sh/busyclaw.git",
		"directory": "packages/plugins/escalations"
	},
	"bugs": {
		"url": "https://github.com/busyclaw-sh/busyclaw/issues"
	},
	"publishConfig": {
		"access": "public"
	},
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		}
	},
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"sideEffects": false,
	"files": [
		"dist",
		"README.md"
	],
	"scripts": {
		"build": "tsc",
		"test": "vitest run tests",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"@busyclaw/contracts": "workspace:*"
	},
	"devDependencies": {
		"@busyclaw/core": "workspace:*",
		"@busyclaw/policy-cedar": "workspace:*",
		"@busyclaw/storage-core": "workspace:*",
		"@busyclaw/storage-durable": "workspace:*",
		"ai": "7.0.22",
		"busyclaw": "workspace:*"
	}
}
