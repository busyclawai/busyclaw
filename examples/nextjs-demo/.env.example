# Copy to .env.local and fill in. Both the app and `busyclaw db migrate` read this file.

# Neon, POOLED — what the app uses. Every serverless invocation opens its own connection, so the
# pooler is what keeps a deploy from exhausting the database's connection limit.
DATABASE_URL=

# Neon, UNPOOLED — what migrations use. The pooler runs PgBouncer in transaction mode, which is the
# wrong shape for DDL. Optional: without it the migrator falls back to DATABASE_URL.
DATABASE_URL_UNPOOLED=

# Azure OpenAI. Leave these unset and the app still boots — it falls back to a scripted model and
# says so in the UI, so nobody films a demo believing a real model answered.
AZURE_OPENAI_RESOURCE_NAME=
AZURE_OPENAI_DEPLOYMENT_NAME=
AZURE_OPENAI_API_KEY=

# Dedup key for PII placeholders (keyed hash — treat as a secret). Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BUSYCLAW_REDACTION_INDEX_KEY=
